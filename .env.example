# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# PROCURA FRONTEND <-> BACKEND INTEGRATION CONFIG
# ==============================================================================
# Set VITE_USE_LIVE_API="true" when connecting to the real backend server.
# Keep "false" for standalone interactive demo mode.
VITE_USE_LIVE_API="false"

# Base REST API URL (e.g. http://localhost:4000/api/v1 or https://api.procura.io/v1)
VITE_API_BASE_URL="http://localhost:4000/api/v1"
